# Copier en .env puis adapter. Générer une clé : openssl rand -base64 48
JWT_SECRET=
DB_PASSWORD=crm
ADMIN_PASSWORD=Admin@2026
SEED_DEMO_DATA=true

# Adresse publique de l'application (liens dans les e-mails, CORS, WebSocket)
PUBLIC_URL=https://localhost:8443
HTTP_PORT=8081
HTTPS_PORT=8443

# Envoi des e-mails (sans MAIL_HOST, les e-mails sont écrits dans les logs)
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@crm.ma

# Assistant de rédaction (facultatif ; sans clé, un modèle de texte standard est utilisé)
ANTHROPIC_API_KEY=
