@startuml cas-utilisation
title CRM — Diagramme de cas d'utilisation
left to right direction
skinparam actorStyle awesome
skinparam packageStyle rectangle

actor "Administrateur" as Admin
actor "Directeur commercial" as Dir
actor "Commercial" as Com
actor "Agent support" as Sup
actor "Client (portail)" as Cli
actor "Visiteur du site" as Visit
actor "Service IA" as IA <<système>>

rectangle "Système CRM" {
  usecase "S'authentifier" as UC0
  usecase "Gérer utilisateurs et rôles" as UC1
  usecase "Configurer la plateforme" as UC2
  usecase "Consulter les tableaux de bord" as UC3
  usecase "Fixer les objectifs" as UC4
  usecase "Valider les devis importants" as UC4b
  usecase "Gérer contacts et entreprises" as UC5
  usecase "Gérer les leads" as UC6
  usecase "Suivre le pipeline" as UC7
  usecase "Créer et envoyer un devis" as UC8
  usecase "Planifier des activités" as UC9
  usecase "Traiter les tickets" as UC10
  usecase "Consulter l'historique client" as UC11
  usecase "Ouvrir et suivre un ticket" as UC12
  usecase "Consulter devis et factures" as UC13
  usecase "Remplir le formulaire de contact" as UC14
  usecase "Scorer un lead" as UC15
  usecase "Rédiger une relance (assistant)" as UC16
  usecase "Exercer ses droits (loi 09-08)" as UC17
}

Admin --> UC1
Admin --> UC2
Admin --> UC17
Dir --> UC3
Dir --> UC4
Dir --> UC4b
Com --> UC5
Com --> UC6
Com --> UC7
Com --> UC8
Com --> UC9
Com --> UC16
Sup --> UC10
Sup --> UC11
Cli --> UC12
Cli --> UC13
Visit --> UC14

UC6 ..> UC15 : <<include>>
UC14 ..> UC6 : <<extend>>
UC15 --> IA
UC16 --> IA
UC8 ..> UC4b : <<extend>>\n(montant ≥ seuil)

note bottom of UC0
  Chaque cas d'utilisation (sauf UC14)
  inclut « S'authentifier »
end note
@enduml
